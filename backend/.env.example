# Example environment variables for KnowledgeOS Backend
# Copy this file to .env and fill in real values before running the application.

# PostgreSQL connection string for asyncpg (required)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/knowledgeos_db

# Supabase / Postgres storage for uploaded files (required)
# SUPABASE_URL is the HTTP endpoint of the Supabase instance (e.g. https://abcd.supabase.co)
SUPABASE_URL=https://your-supabase-instance.supabase.co
# Service role key (KEEP SECRET) used by server-side operations
SUPABASE_SERVICE_ROLE_KEY=supabase-service-role-key-placeholder
# Name of the Supabase storage bucket used to store uploaded files
SUPABASE_STORAGE_BUCKET=your-storage-bucket-name

# Directory used by Chroma to persist vector store files (required)
# Must be an absolute path that the application can read/write.
CHROMA_PERSIST_DIRECTORY=C:\path\to\chroma\persist\directory

# LLM provider configuration (required for production LLM & embeddings)
# Supported provider names depend on integrations in the codebase (e.g., "litellm")
LLM_PROVIDER=litellm
# API key for the chosen LLM provider (KEEP SECRET)
LLM_API_KEY=your-llm-api-key
# Default model name to use for embeddings and completions
# Example embedding model: text-embedding-3-small
# Example completion model: gpt-4o or other provider-specific model
LLM_MODEL_NAME=text-embedding-3-small
# Optional custom API base URL if using a self-hosted or proxied LLM provider
# Leave empty or remove if not required
LLM_API_URL=

# Optional: Additional environment variables used by deployment or auth
# CORS origins (comma-separated) - enable if using browser-based frontend
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Note: Do NOT commit real secret values into version control.
# Use a secrets manager or CI/CD protected variables for production deployments.
